*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.dist-info/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Flask / SQLite instance folder & database files
backend/instance/
*.db
*.sqlite
*.sqlite3

# Uploaded files (user-submitted resumes, etc.)
backend/uploads/

# ML model files (large binaries — download/train separately)
backend/ml/*.pkl
backend/ml/*.joblib
backend/ml/*.h5
backend/ml/*.bin
backend/ml/*.pt
backend/ml/*.pth
backend/ml/models/

# Environment variables
.env
.env.*
!.env.example

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# MyPy
.mypy_cache/

